{
  "name": "Supabase",
  "task": "action.supabase",
  "type": "action",
  "credentialProvider": "supabase",
  "description": "Query, insert, update, delete data and invoke Edge Functions in Supabase",
  "parameters": [
    {
      "label": "Operation",
      "name": "operation",
      "type": "dropdown",
      "value": "query_rows",
      "options": [
        { "label": "Query Rows", "value": "query_rows" },
        { "label": "Insert Rows", "value": "insert_rows" },
        { "label": "Update Rows", "value": "update_rows" },
        { "label": "Delete Rows", "value": "delete_rows" },
        { "label": "Upsert Rows", "value": "upsert_rows" },
        { "label": "Invoke Function", "value": "invoke_function" }
      ],
      "required": true
    },
    {
      "label": "Table Name",
      "name": "table",
      "type": "input",
      "value": "",
      "required": true,
      "dependsOn": [{"parameter": "operation", "values": ["query_rows", "insert_rows", "update_rows", "delete_rows", "upsert_rows"]}]
    },
    {
      "label": "Select Columns",
      "name": "selectColumns",
      "type": "input",
      "value": "*",
      "required": false,
      "dependsOn": [{"parameter": "operation", "values": ["query_rows"]}]
    },
    {
      "label": "Filter",
      "name": "filter",
      "type": "input",
      "value": "",
      "required": false,
      "placeholder": "e.g. id=eq.1 or status=eq.active",
      "dependsOn": [{"parameter": "operation", "values": ["query_rows", "update_rows", "delete_rows"]}]
    },
    {
      "label": "Data",
      "name": "data",
      "type": "textarea",
      "value": "",
      "required": true,
      "placeholder": "{\"column\": \"value\"}",
      "dependsOn": [{"parameter": "operation", "values": ["insert_rows", "update_rows", "upsert_rows"]}]
    },
    {
      "label": "Order By",
      "name": "orderBy",
      "type": "input",
      "value": "",
      "required": false,
      "placeholder": "e.g. created_at.desc",
      "dependsOn": [{"parameter": "operation", "values": ["query_rows"]}]
    },
    {
      "label": "Limit",
      "name": "limit",
      "type": "input",
      "value": "",
      "required": false,
      "dependsOn": [{"parameter": "operation", "values": ["query_rows"]}]
    },
    {
      "label": "Offset",
      "name": "offset",
      "type": "input",
      "value": "",
      "required": false,
      "dependsOn": [{"parameter": "operation", "values": ["query_rows"]}]
    },
    {
      "label": "Function Name",
      "name": "functionName",
      "type": "input",
      "value": "",
      "required": true,
      "dependsOn": [{"parameter": "operation", "values": ["invoke_function"]}]
    },
    {
      "label": "Function Body",
      "name": "functionBody",
      "type": "textarea",
      "value": "",
      "required": false,
      "placeholder": "{\"key\": \"value\"}",
      "dependsOn": [{"parameter": "operation", "values": ["invoke_function"]}]
    }
  ],
  "settings": {
    "retryCount": 0,
    "timeout": 30000,
    "continueOnFail": false
  }
}
